# Spring Boot KHÔNG tự đọc file này. Đặt các biến dưới đây vào môi trường
# (PowerShell: $env:DB_PASSWORD="..."), hoặc vào Run Configuration của IntelliJ.
DB_URL=jdbc:mysql://localhost:3306/tripplanner?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=
# Chuỗi ngẫu nhiên >= 32 byte, ví dụ tạo bằng: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_DAYS=7
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Chỉ dùng khi chạy test tích hợp (./mvnw test). Không đặt TEST_DB_URL thì test tích hợp tự bỏ qua.
TEST_DB_URL=jdbc:mysql://localhost:3306/tripplanner_test?createDatabaseIfNotExist=true
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=

# Tạo tài khoản + chuyến đi mẫu khi khởi động (DevDataSeeder). Chỉ bật ở local.
APP_SEED_ENABLED=false

# Lưu ảnh upload (MinIO / S3)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=trip-planner
# Địa chỉ trình duyệt dùng để tải ảnh (điện thoại trong LAN: http://<IP máy>:9000)
MINIO_PUBLIC_URL=http://localhost:9000
# Chỉ dùng cho test tích hợp với MinIO thật (bỏ trống = bỏ qua)
MINIO_TEST_ENDPOINT=
