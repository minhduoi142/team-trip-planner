# Spring Boot KHÔNG tự đọc file này. Đặt các biến dưới đây vào môi trường
# (PowerShell: $env:DB_PASSWORD="..."), hoặc vào Run Configuration của IntelliJ.
DB_URL=jdbc:mysql://localhost:3306/tripplanner?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=
# Chuỗi ngẫu nhiên >= 32 byte, ví dụ tạo bằng: openssl rand -base64 48
JWT_SECRET=
# Access token ngắn (phút); phiên dài nhờ refresh token trong cookie HttpOnly (docs/sdd-refresh-token.md)
JWT_ACCESS_TTL_MINUTES=15
# AUTH_REFRESH_TTL_DAYS=14
# AUTH_FAMILY_MAX_DAYS=60
# AUTH_REUSE_GRACE_SECONDS=10
# Chỉ đặt false khi chạy HTTP mà không phải localhost (vd truy cập bằng IP LAN)
# AUTH_COOKIE_SECURE=true
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Chỉ dùng khi chạy test tích hợp (./mvnw test). Không đặt TEST_DB_URL thì test tích hợp tự bỏ qua.
TEST_DB_URL=jdbc:mysql://localhost:3306/tripplanner_test?createDatabaseIfNotExist=true
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=

# Tạo tài khoản + chuyến đi mẫu khi khởi động (DevDataSeeder). Chỉ bật ở local.
APP_SEED_ENABLED=false

# Lưu ảnh upload (MinIO / S3)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=trip-planner
# Địa chỉ trình duyệt dùng để tải ảnh (điện thoại trong LAN: http://<IP máy>:9000)
MINIO_PUBLIC_URL=http://localhost:9000
# Chỉ dùng cho test tích hợp với MinIO thật (bỏ trống = bỏ qua)
MINIO_TEST_ENDPOINT=

# Link chia sẻ /share/{code}: FE nhận người bấm link; URL công khai của backend (cho ảnh xem trước og:image)
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080

# Email thông báo (docs/sdd-email-notifications.md). Bỏ trống MAIL_HOST = tắt gửi email.
# Local với Mailpit (docker compose up -d, xem thư ở http://localhost:8025):
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=trip@localhost
# Gmail thật: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SMTP_AUTH=true, MAIL_STARTTLS=true,
# MAIL_USERNAME=<địa chỉ Gmail>, MAIL_PASSWORD=<App Password 16 ký tự, tạo ở https://myaccount.google.com/apppasswords
# sau khi bật Xác minh 2 bước>, MAIL_FROM=<trùng MAIL_USERNAME>
# MAIL_FROM_NAME=Trip Planner
# Giới hạn email/ngày (Gmail cá nhân ~500 người nhận/ngày)
# NOTIFY_DAILY_LIMIT=400
# 0 = gửi ngay; > 0 = chờ N phút để gộp nhiều sự kiện cùng chuyến vào 1 email
# NOTIFY_DELAY_MINUTES=0
