# Biến cho docker-compose.yml (MinIO local). Copy thành .env rồi đặt mật khẩu riêng (.env đã được gitignore).
MINIO_ROOT_USER=tripplanner-admin
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
MINIO_BUCKET=trip-planner
# Giấy tờ chuyến đi (vé, CCCD…): bucket RIÊNG TƯ, minio-init/ backend tự tạo, không bật đọc công khai
MINIO_PRIVATE_BUCKET=trip-planner-private
