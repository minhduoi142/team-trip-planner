# Cấu hình production cho docker-compose.prod.yml. Trên VPS:
#   cp .env.prod.example .env.prod && nano .env.prod
# .env.prod đã được .gitignore — KHÔNG commit. Sinh chuỗi ngẫu nhiên:  openssl rand -hex 32

# Tên miền đã trỏ A record về IP VPS. Caddy tự lấy HTTPS cho SITE_ADDRESS.
SITE_ADDRESS=trip.example.com
PUBLIC_URL=https://trip.example.com
# Chưa có tên miền (chỉ HTTP theo IP, KHÔNG khuyến nghị — Google login và share link sẽ không hoạt động tốt):
# SITE_ADDRESS=:80
# PUBLIC_URL=http://<IP-VPS>

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=tripplanner
MYSQL_USER=tripplanner
MYSQL_PASSWORD=

# Backend
JWT_SECRET=
JWT_EXPIRATION_DAYS=7
# Bỏ trống = tắt đăng nhập Google. Có thì thêm PUBLIC_URL vào "Authorized JavaScript origins" trên Google Cloud.
GOOGLE_CLIENT_ID=

# MinIO (ảnh upload)
MINIO_ROOT_USER=tripplanner-admin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=trip-planner

# Tùy chọn
# JAVA_OPTS=-Xmx512m -XX:+UseSerialGC
# HTTP_PORT=80
# HTTPS_PORT=443
