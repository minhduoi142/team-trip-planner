# Cấu hình production cho docker-compose.prod.yml. Trên VPS:
#   cp .env.prod.example .env.prod && nano .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# .env.prod đã được .gitignore — KHÔNG commit. Sinh chuỗi ngẫu nhiên:  openssl rand -hex 32

# Địa chỉ công khai (nginx máy chủ giữ HTTPS, proxy /api/ /share/ /trip-planner/ / vào các cổng 127.0.0.1)
PUBLIC_URL=https://minhduoipro.ddns.net

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=tripplanner
MYSQL_USER=tripplanner
MYSQL_PASSWORD=

# Backend
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
# Bỏ trống = tắt đăng nhập Google. Có thì thêm PUBLIC_URL vào "Authorized JavaScript origins" trên Google Cloud.
GOOGLE_CLIENT_ID=

# MinIO (ảnh upload)
MINIO_ROOT_USER=tripplanner-admin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=trip-planner
# Giấy tờ chuyến đi (vé, CCCD…): bucket RIÊNG TƯ, minio-init/ backend tự tạo, không bật đọc công khai
MINIO_PRIVATE_BUCKET=trip-planner-private

# Email thông báo (docs/sdd-email-notifications.md). Bỏ trống MAIL_HOST = tắt gửi email.
# Gmail: bật Xác minh 2 bước → tạo App Password ở https://myaccount.google.com/apppasswords (16 ký tự, bỏ dấu cách)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
# Phải trùng MAIL_USERNAME (Gmail tự thay địa chỉ người gửi khác bằng tài khoản đăng nhập)
MAIL_FROM=
MAIL_FROM_NAME=Trip Planner
# Gmail cá nhân ~500 người nhận/ngày
NOTIFY_DAILY_LIMIT=400
# 0 = có sự kiện là gửi luôn (chậm nhất ~10 giây). Đặt vd 10 để chờ 10 phút, gộp nhiều sự kiện vào 1 email
NOTIFY_DELAY_MINUTES=0

# Dự báo thời tiết (docs/sdd-weather.md): Open-Meteo miễn phí, không cần key. Backend cần ra Internet (HTTPS).
# false = tắt hẳn (UI tự ẩn phần thời tiết)
WEATHER_ENABLED=true
# Tìm địa điểm chi tiết (làng/bản, xã, thác, hồ…) qua Photon/OpenStreetMap; để trống = chỉ dùng Open-Meteo
# WEATHER_PHOTON_URL=https://photon.komoot.io/api/

# Liên hệ ở landing: số Zalo (bỏ trống = ẩn nút Zalo) và Gmail nhận góp ý
CONTACT_ZALO=
CONTACT_EMAIL=

# Tùy chọn
# JAVA_OPTS=-Xmx384m -XX:+UseSerialGC
# FRONTEND_PORT=3000
# BACKEND_PORT=8080
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
