# Copy thành .env.local rồi điền giá trị (Vite tự đọc .env.local)
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Bỏ trống thì ẩn nút "Đăng nhập với Google"
VITE_GOOGLE_CLIENT_ID=

# Gốc của link chia sẻ có ảnh xem trước (trang /share/{code} do backend phục vụ). Bỏ trống = origin của API
VITE_SHARE_BASE_URL=
